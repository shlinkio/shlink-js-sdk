{
  "name": "@shlinkio/shlink-js-sdk",
  "description": "A Shlink's REST API client for JS runtimes: the browser, Node.js, Deno and Bun",
  "homepage": "https://shlink.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlinkio/shlink-js-sdk.git"
  },
  "author": "Alejandro Celaya <alejandro@alejandrocelaya.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-contract": {
      "types": "./dist/api-contract/index.d.ts",
      "import": "./dist/api-contract.js"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.ts",
      "import": "./dist/fetch.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:integration": "test/run-integration-tests.sh",
    "test:ci": "node --run test -- --coverage",
    "cs": "node --run lint && node --run format:check",
    "cs:fix": "node --run lint:fix && node --run format",
    "lint": "oxlint src test *.config.ts",
    "lint:fix": "node --run lint -- --fix",
    "format": "oxfmt src test *.config.{js,ts}",
    "format:check": "node --run format -- --check",
    "types": "tsc --erasableSyntaxOnly",
    "docs:dev": "serve docs --listen 3033"
  },
  "devDependencies": {
    "@shlinkio/eslint-config-js-coding-standard": "~4.1.0",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^26.2.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "serve": "^14.2.6",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.3"
  }
}
